# Frontend-to-backend API base URL.
# If omitted, local development uses http://localhost:4000 and production uses Render.
# Docker/local self-hosting should set this before building the frontend image;
# NEXT_PUBLIC_* values are baked into the browser bundle by Next.js.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Optional Docker Compose host port override.
WEB_PORT=3000

# Vercel production value:
# NEXT_PUBLIC_API_BASE_URL=https://nba82-0-server.onrender.com
